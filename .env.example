# 로컬 개발: cp .env.example .env
# 운영: 서버의 ~/dj2/.env 로 복사해 채운다 (TRUST_PROXY_HOPS=2).

PORT=3000
# 운영은 Cloudflare → NPM 두 단계를 거치므로 2 (로컬 개발은 0)
TRUST_PROXY_HOPS=0
DATA_DIR=./data

# v2 DB. 운영에서는 compose 의 mysql 컨테이너(DB_HOST 는 compose 가 mysql 로 덮어씀).
# 비워 두면 DB 없이 실행된다 (화면 작업용).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lolwikidj_v2
# compose 의 mysql 컨테이너 root 비밀번호 (운영만)
MYSQL_ROOT_PASSWORD=
# 레거시 → v2 이전 시에만 사용 (npm run db:migrate-legacy)
LEGACY_DATABASE_URL=

YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_SECRET=
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# compose 에서는 ./secrets/google-tts.json 이 /run/secrets/app/google-tts.json 으로 마운트된다.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/app/google-tts.json
TOONATION_SESSION_ID=
MASTER_IP=
