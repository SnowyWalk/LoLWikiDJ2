# 로컬 개발: cp .env.example .env
# 운영: GitHub Actions 가 GitHub Secrets 로 EC2 의 .env 를 생성한다.

PORT=3000
TRUST_PROXY_HOPS=1
DATA_DIR=./data

# EC2 호스트의 기존 MySQL (compose 는 host 네트워크라 그대로 접속된다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=LoLWikiDJ_DB

TWITCH_CLIENT_ID=
TWITCH_SECRET=
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# compose 에서는 ./secrets/google-tts.json 이 /run/secrets/app/google-tts.json 으로 마운트된다.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/app/google-tts.json
TOONATION_SESSION_ID=
MASTER_IP=
